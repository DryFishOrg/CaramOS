#!/bin/bash
# Hook: sửa lỗi trình cài đặt (ubiquity) trong phiên live
# Chạy BÊN TRONG chroot.
#
# Ticket H-1040: trình cài đặt dừng ngay sau khi mở, báo
#   misc.py, _on_got_unit_proxy: AttributeError: 'NoneType' object has no attribute 'get_string'
# Ubiquity hỏi systemd qua D-Bus trạng thái sound.target để phát tiếng "sẵn sàng". Khi lời gọi lấy thuộc
# tính không thành công (systemd bận hoặc đang khởi động lại, ví dụ lúc đang cài gói), proxy D-Bus không
# có ActiveState và ubiquity gọi .get_string() trên None. Cửa sổ lỗi còn mở thì ubiquity vẫn giữ khoá
# debconf, nên cài phần mềm khác trong phiên live cũng hỏng: "config.dat is locked by another process"
# (ticket H-1041). Sửa: không có ActiveState (hoặc không tạo được proxy) thì bỏ qua, chỉ mất tiếng báo.
# Bản ubiquity khác (đã sửa hoặc đổi code) thì để nguyên, không làm hỏng build.

set -e

MISC=/usr/lib/ubiquity/ubiquity/misc.py

echo "[CaramOS] === SỬA LỖI TRÌNH CÀI ĐẶT ==="
if [ ! -f "$MISC" ]; then
    echo "[CaramOS] Không có $MISC, bỏ qua"
    exit 0
fi

python3 - "$MISC" <<'PY'
import sys
from pathlib import Path

path = Path(sys.argv[1])
source = path.read_text(encoding="utf-8")
marker = "# CaramOS H-1040"
old = '''    def _on_got_unit_proxy(self, conn, res, cb):
        self.proxy = conn.new_finish(res)
        self.properties_changed_signal = self.proxy.connect(
            "g-properties-changed", self._on_properties_changed, cb
        )
        active_state = self.proxy.get_cached_property(
            "ActiveState"
        ).get_string()
        if active_state == "active":
'''
new = '''    def _on_got_unit_proxy(self, conn, res, cb):
        # CaramOS H-1040: when systemd did not answer the property request (or the proxy was not
        # made) there is no ActiveState: skip the "system ready" sound instead of crashing the installer.
        try:
            self.proxy = conn.new_finish(res)
        except GLib.Error:
            return
        self.properties_changed_signal = self.proxy.connect(
            "g-properties-changed", self._on_properties_changed, cb
        )
        active_state = self.proxy.get_cached_property("ActiveState")
        if active_state is not None and active_state.get_string() == "active":
'''
if marker in source:
    print("[OK] ubiquity misc.py đã được sửa từ trước")
elif source.count(old) == 1:
    path.write_text(source.replace(old, new, 1), encoding="utf-8")
    print("[OK] ubiquity misc.py: không còn dừng khi thiếu ActiveState của sound.target")
else:
    print("[WARN] ubiquity misc.py khác bản đã biết, để nguyên")
PY
python3 -m py_compile "$MISC"
