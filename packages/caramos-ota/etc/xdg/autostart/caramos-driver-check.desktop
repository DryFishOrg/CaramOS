[Desktop Entry]
Type=Application
Name=CaramOS Driver Check
Comment=Check the hardware drivers at login and tell about missing ones
Exec=/usr/bin/caramos-driver-check --autostart
Icon=hardinfo
Terminal=false
NoDisplay=true
OnlyShowIn=X-Cinnamon;
X-GNOME-Autostart-Phase=Applications
# After the App Center's first-run picker (8 s), so a missing network driver is shown on top of it:
# without internet the picker cannot install anything.
X-GNOME-Autostart-Delay=12
