<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <action id="net.vietnamlinuxfamily.caramos-ota.upgrade">
    <description>Run CaramOS OTA upgrade</description>
    <description xml:lang="vi">Chạy cập nhật OTA của CaramOS</description>
    <message>Authentication is required to install CaramOS updates</message>
    <message xml:lang="vi">Cần xác thực để cài bản cập nhật CaramOS</message>
    <icon_name>system-software-update</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/caramos-ota</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
  <!-- Driver Check's one-click driver install. The helper installs only drivers Ubuntu recommends for this
       computer's hardware (UbuntuDrivers); _keep so "Install all" asks once. -->
  <action id="net.vietnamlinuxfamily.caramos-ota.driver-install">
    <description>Install hardware drivers with Driver Check</description>
    <description xml:lang="vi">Cài driver phần cứng bằng Kiểm tra driver</description>
    <message>Authentication is required to install drivers</message>
    <message xml:lang="vi">Cần xác thực để cài driver</message>
    <icon_name>hardinfo</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/share/caramos-ota/driver-check/caramos-driver-check-helper</annotate>
  </action>
  <!-- Driver Check's hardware report. allow_gui keeps DISPLAY so hw-probe can collect the X11 logs. -->
  <action id="net.vietnamlinuxfamily.caramos-ota.hw-probe">
    <description>Create a hardware report with hw-probe</description>
    <description xml:lang="vi">Tạo báo cáo phần cứng bằng hw-probe</description>
    <message>Authentication is required to collect hardware information for the report</message>
    <message xml:lang="vi">Cần xác thực để thu thập thông tin phần cứng cho báo cáo</message>
    <icon_name>hardinfo</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/hw-probe</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
