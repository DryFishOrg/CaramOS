[Desktop Entry]
Type=Application
Name=Driver Check
Name[vi]=Kiểm tra driver
Comment=See which hardware works, which drivers are missing and how to install them
Comment[vi]=Xem phần cứng nào đã chạy, máy còn thiếu driver nào và cách cài
Exec=/usr/bin/caramos-driver-check
Icon=hardinfo
Terminal=false
Categories=System;Settings;HardwareSettings;
Keywords=CaramOS;Driver;Drivers;Hardware;Wi-Fi;WiFi;Network;NVIDIA;Broadcom;Bluetooth;Webcam;hw-probe;Phần cứng;Trình điều khiển;Mạng;Thiếu driver;
StartupNotify=true
# Matches the window so the taskbar shows this entry's icon.
StartupWMClass=caramos-driver-check
