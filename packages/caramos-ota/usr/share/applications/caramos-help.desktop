[Desktop Entry]
Type=Application
Name=Feedback & Help
Name[vi]=Góp ý & hỗ trợ
Comment=Ask the VNLF community for help, report a bug or send feedback about CaramOS
Comment[vi]=Nhờ cộng đồng VNLF giúp đỡ, báo lỗi hoặc góp ý cho CaramOS
Exec=/usr/bin/caramos-help
Icon=help-browser
Terminal=false
Categories=System;Utility;
Keywords=CaramOS;VNLF;Help;Support;Bug;Report;Feedback;Vietnam Linux Family;Hỗ trợ;Giúp đỡ;Báo lỗi;Góp ý;Lỗi;
StartupNotify=true
# Matches the window so the taskbar shows this entry's icon.
StartupWMClass=caramos-help
